# StoryWeaver — Environment Variables
# Copy this to .env and fill in your keys. Never commit .env.

# AI / LLMs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Finance
MASSIVE_API_KEY=
COINGECKO_API_KEY=

# News
NEWSAPI_KEY=

# Weather
OPENWEATHER_API_KEY=

# Supabase (required if DB_TYPE = supabase or both)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Drive (OAuth2 — see ARCHITECTURE.md)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/oauth/callback
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_REFRESH_TOKEN=

NODE_ENV=development
