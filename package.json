{
  "name": "StoryWeaver",
  "version": "0.1.0",
  "description": "Generated by create-stephen-app",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && electron .\"",
    "dev": "vercel dev",
    "dev:react": "react-scripts start",
    "build": "react-scripts build",
    "dist": "npm run build && electron-builder",
    "electron": "electron ."
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "@anthropic-ai/sdk": "latest",
    "openai": "latest",
    "@google/generative-ai": "latest",
    "@polygon.io/client-js": "latest",
    "newsapi": "latest",
    "googleapis": "latest",
    "@supabase/supabase-js": "latest"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.stephen.StoryWeaver",
    "productName": "StoryWeaver",
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "src/services/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  }
}
